<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Pen x:Key="Lucide.Icon.Pen" Brush="{DynamicResource Element.Foreground}" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
    <Pen x:Key="Lucide.Record.Pen" Brush="#FFD13438" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>

    <DrawingBrush x:Key="Vector.Lucide.Settings" Stretch="Uniform" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Pen="{StaticResource Lucide.Icon.Pen}" Geometry="M 14,17 L 5,17 M 19,7 L 10,7"/>
                <GeometryDrawing Pen="{StaticResource Lucide.Icon.Pen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="17,17" RadiusX="3" RadiusY="3"/>
                            <EllipseGeometry Center="7,7" RadiusX="3" RadiusY="3"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Vector.Lucide.Gauge" Stretch="Uniform" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Pen="{StaticResource Lucide.Icon.Pen}" Geometry="M 12,14 L 16,10 M 3.34,19 A 10,10 0 1 1 20.66,19"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Vector.Lucide.Scan" Stretch="Uniform" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
