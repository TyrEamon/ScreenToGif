                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Vector.Lucide.Pause" Stretch="Uniform" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
